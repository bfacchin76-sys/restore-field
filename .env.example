# =============================================================================
# FieldRestore — environment configuration
# Copy to .env.local for development, or set as real env vars in production.
# =============================================================================

# --- Database --------------------------------------------------------------
# Local dev (docker-compose.dev.yml): postgres://fieldrestore:fieldrestore@localhost:5432/fieldrestore
DATABASE_URL="postgresql://fieldrestore:fieldrestore@localhost:5432/fieldrestore"
SHADOW_DATABASE_URL="postgresql://fieldrestore:fieldrestore@localhost:5432/fieldrestore_shadow"

# --- Redis (BullMQ) --------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- S3-compatible object storage ------------------------------------------
# In dev: MinIO from docker-compose.dev.yml.
# In prod: MinIO on the same VPS, or Cloudflare R2 / Backblaze B2.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="fieldrestore"
S3_SECRET_KEY="fieldrestore-dev-secret"
S3_BUCKET="fieldrestore"
S3_FORCE_PATH_STYLE="true"

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-please-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production-please-use-openssl-rand-base64-32"

# --- SMTP (used for magic links, password reset, share notifications) ------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FieldRestore <noreply@example.com>"

# --- Initial owner / org seed (read once; ignored after first migration) ---
INITIAL_OWNER_EMAIL="brian@example.com"
INITIAL_OWNER_PASSWORD="change-me-on-first-login"
INITIAL_OWNER_NAME="Brian Facchin"
ORG_NAME="1-800 Water Damage of Nassau County"
ORG_SLUG="1800wd-nassau"
ORG_PRIMARY_COLOR="#1e3a8a"
ORG_REPORT_FOOTER="1-800 Water Damage of Nassau County"
ORG_JOB_NUMBER_PREFIX="1800WD"

# --- Logging ---------------------------------------------------------------
LOG_LEVEL="info"
NODE_ENV="development"

# =============================================================================
# Production-only (docker-compose.yml). Phase 10.
# =============================================================================

# Public hostname Caddy serves on. No protocol, no trailing slash.
DOMAIN="fieldrestore.example.com"

# Storage driver: "local" (HMAC-signed paths via /api/storage/[...path])
# or "s3" (MinIO / R2 / etc.). LocalStorage isn't recommended for prod
# because the app must serve every byte itself.
STORAGE_DRIVER="s3"

# Postgres credentials used by the compose stack.
POSTGRES_DB="fieldrestore"
POSTGRES_USER="fieldrestore"
POSTGRES_PASSWORD=""

# Image to pull on `docker compose pull`. Defaults to :latest from GHCR.
IMAGE="ghcr.io/bfacchin76-sys/restore-field:latest"

# --- Backup (Restic) -------------------------------------------------------
# Examples:
#   sftp:user@host:/var/restic/fieldrestore
#   s3:s3.amazonaws.com/my-bucket/fieldrestore
#   rest:https://restic.example.com/fieldrestore/
RESTIC_REPOSITORY=""
RESTIC_PASSWORD=""
# Only when RESTIC_REPOSITORY is an s3:* URL:
RESTIC_S3_ACCESS_KEY=""
RESTIC_S3_SECRET_KEY=""
