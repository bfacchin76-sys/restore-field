# Caddy reverse proxy for FieldRestore. Auto-HTTPS via Let's Encrypt.
# Set DOMAIN in .env to fieldrestore.example.com.

{$DOMAIN} {
	# Trust only proxy headers we set ourselves; Caddy sets these by default.
	encode zstd gzip

	# Belt-and-braces security headers. The Next app sets a stricter
	# CSP + Permissions-Policy via `next.config.ts`; Caddy keeps HSTS +
	# X-Content-Type-Options as a backstop in case the upstream is slow
	# to start and serves an error page directly. PRD §11 task 3.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		# The app itself sets X-Frame-Options DENY + a tighter
		# Permissions-Policy; remove any version Caddy might set so
		# the upstream's wins.
		-Server
	}

	# Long-cache static assets the app emits (Next.js sets immutable hashes).
	@assets path /_next/static/* /icons/* /manifest.webmanifest /sw.js
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Proxy everything else to the Next.js app on the internal network.
	reverse_proxy app:3000 {
		# Forward client IP / proto / host so Auth.js + audit log get them right.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
}
